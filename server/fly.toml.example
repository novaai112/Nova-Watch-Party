# Fly.io example: `fly launch --copy-config` then `fly volumes create nova_data --size 1` and `fly deploy`
app = "nova-watch-party"
primary_region = "sin"
[build]
[env]
  PORT = "8080"
  DATA_DIR = "/data"
[mounts]
  source = "nova_data"
  destination = "/data"
[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = false   # keep running so live rooms are not dropped
  min_machines_running = 1
