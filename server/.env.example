PORT=8080
DATA_DIR=./data
# DEV_MODE=1          # local testing only: API returns the login code. NEVER in production.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM="Nova Watch Party <no-reply@example.com>"
# GOOGLE_WEB_CLIENT_ID=
# FCM_SERVICE_ACCOUNT_JSON=/path/to/service-account.json
# ADMIN_TOKEN=long-random-string     # enables GET /admin/reports with header x-admin-token
# PRIVACY_HTML=<h1>...</h1>
# TERMS_HTML=<h1>...</h1>
# DATABASE_URL=postgres://user:pass@host/db   # free Postgres (Neon/Supabase) so accounts survive redeploys; uploads still need a disk/volume
